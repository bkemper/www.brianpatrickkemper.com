{
  "compilerOptions": {
    "esModuleInterop": true,
    "alwaysStrict": true,
    "declaration": true,
    "lib": ["es2022"],
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "outDir": "dist",
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2022"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
